{
  "name": "biblioteca-de-secoes",
  "version": "1.0.0",
  "description": "Biblioteca de seções reutilizáveis (HTML/CSS/JS) compartilhada na rede local",
  "main": "src/worker.js",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply biblioteca-secoes-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply biblioteca-secoes-db --remote",
    "build:css": "npx sass style.scss public/assets/css/style.css --style=compressed --no-source-map",
    "watch:css": "npx sass --watch style.scss public/assets/css/style.css"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
